{
  "schema": "piccompare-aec-capabilities/1.0",
  "note": "Command-line and external-engine capabilities. This public repository does not ship an AI-assistant tool server; this manifest is the stable index of the commands a future wrapper would expose. MCP means Model Context Protocol, a standard way for AI assistants to discover tools.",
  "tools": [
    {
      "name": "aec.measure",
      "description": "Measure one generated floor-plan pair and write a fingerprinted (hashed) report.",
      "transport": "cli",
      "status": "available",
      "input_schema": {"fixture": "string", "out": "string|null"},
      "example": "python -m aec measure --fixture fixtures/aec/resize-01 --out runs/measure/resize-01"
    },
    {
      "name": "aec.verify",
      "description": "Verify the report fingerprint, input fingerprints, element fingerprints and measurement fingerprints.",
      "transport": "cli",
      "status": "available",
      "input_schema": {"report": "string", "inputs_dir": "string|null"},
      "example": "python -m aec verify --report runs/measure/resize-01/report.json --inputs-dir fixtures/aec/resize-01"
    },
    {
      "name": "aec.export",
      "description": "Export a measured plan to SVG (scalable vector graphics) and/or DXF (a standard computer-aided design exchange format).",
      "transport": "cli",
      "status": "available",
      "input_schema": {"report": "string", "format": "svg|dxf|both", "out": "string"},
      "example": "python -m aec export --report runs/measure/resize-01/report.json --out runs/export"
    },
    {
      "name": "aec.engine_info",
      "description": "Find a local PicCompare build from a configuration file or an explicit folder path.",
      "transport": "cli",
      "status": "available",
      "input_schema": {"workspace_root": "string|null", "engine_tree": "string|null"},
      "example": "python -m aec engine-info --engine-tree ../PicCompare_0.55C"
    },
    {
      "name": "aec.batch",
      "description": "Combine per-pair reports into one summary sorted by how much each change matters.",
      "transport": "cli",
      "status": "available",
      "input_schema": {"reports": "string", "out": "string"},
      "example": "python scripts/run_batch.py --reports runs/eval --out runs/batch"
    },
    {
      "name": "aec.eval",
      "description": "Run the test-example evaluation, offline (repeatable, no model call) or live (Meta's model service).",
      "transport": "cli",
      "status": "available",
      "input_schema": {"fixtures": "string", "out": "string", "pairs": "string[]|null", "live": "boolean"},
      "example": "python scripts/run_eval.py --fixtures fixtures --out runs/eval"
    },
    {
      "name": "piccompare.compare_documents",
      "description": "External engine: repeatable document comparison.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"a": "path", "b": "path", "dpi": "integer", "align": "string"},
      "example": "agent_cli.py compare a.pdf b.pdf --dpi 110 --align none --json"
    },
    {
      "name": "piccompare.get_regions",
      "description": "External engine: changed regions and page size and position.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"comparison_id": "string", "kind": "string", "limit": "integer"},
      "example": "agent_cli.py regions --comparison-id c1 --kind all --limit 200 --json"
    },
    {
      "name": "piccompare.get_crop",
      "description": "External engine: cropped image file for a changed region.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"comparison_id": "string", "region_id": "string", "view": "string"},
      "example": "agent_cli.py crop --comparison-id c1 --region-id r1 --view diff --json"
    },
    {
      "name": "piccompare.get_page_image",
      "description": "External engine: page image file.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"comparison_id": "string", "side": "a|b", "page": "integer"},
      "example": "agent_cli.py page --comparison-id c1 --side a --page 0 --json"
    },
    {
      "name": "piccompare.export_report",
      "description": "External engine: engine-generated report file.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"comparison_id": "string", "format": "string"},
      "example": "agent_cli.py report --comparison-id c1 --format md --json"
    },
    {
      "name": "piccompare.align",
      "description": "External engine: alignment mapping between two pages.",
      "transport": "engine-cli",
      "status": "external",
      "input_schema": {"a": "path", "b": "path", "page_a": "integer", "page_b": "integer"},
      "example": "agent_cli.py align a.pdf b.pdf --page-a 0 --page-b 0 --method ecc --json"
    }
  ]
}
